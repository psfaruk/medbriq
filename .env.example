# Medbriq — environment configuration template
# Copy to .env and adjust. NEVER commit the real .env file.

# SQLite database (local, free-first MVP). For production, the app switches to
# Firestore via FIREBASE_SERVICE_ACCOUNT below — see docs/database.md §8.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Node environment: development | test | production
NODE_ENV=development

# Public base URL of the web app (used for future email links)
APP_BASE_URL=http://localhost:3000

# ── Production data store (Firebase Firestore) ──────────────────────────
# Compact one-line JSON of a Firebase service-account key, e.g.
#   FIREBASE_SERVICE_ACCOUNT="$(jq -c . service-account.json)"
# When set (and valid JSON) the app uses the FirestoreStore (firebase-admin,
# server-side only) instead of the local Prisma/SQLite store. Leave unset for
# local development. NEVER commit the real value.
FIREBASE_SERVICE_ACCOUNT=

# Firestore database id within the Firebase project. The Firebase admin
# SDK names the default database "(default)" — with the parentheses. Leaving
# this unset also falls back to "(default)".
FIREBASE_DATABASE_ID=(default)

# ── Phone OTP authentication (login + password reset) ──────────────────
# SMS provider abstraction. "console" (default) is DEV MODE: the OTP is
# logged server-side and returned in the API response (clearly labeled) so
# the flow is testable without a paid SMS provider. Production REFUSES
# phone OTP while this is set (echoed codes would allow account takeover).
#
# REAL SMS: set SMS_PROVIDER=twilio plus the three values below (from
# https://console.twilio.com — Account SID and Auth Token on the dashboard;
# SMS_SENDER_ID is a Twilio phone number like +15551234567, or an approved
# alphanumeric sender ID). BD local numbers (01XXXXXXXXX) are converted to
# E.164 (+880…) automatically. Until all three are set, phone sign-in and
# SMS password reset stay honestly unavailable in production.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=

# ── Google Sign-In (Google Identity Services) ──────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console (Credentials page) of
# the medbricbd Firebase project. Required for BOTH the browser GIS button
# and server-side ID-token audience verification. Leave empty to disable
# Google sign-in (the UI shows an honest "not configured" state).
GOOGLE_CLIENT_ID=

# ── Firebase web (client) config — push notifications + Google sign-in ──
# Same values as the firebaseConfig object of the Firebase web app
# (Firebase console → Project settings → Your apps → SDK setup).
# Public by design; set on Vercel for production builds.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Web Push certificate key pair (Firebase console → Cloud
# Messaging → Web Push certificates). Improves token reliability.
NEXT_PUBLIC_FIREBASE_PUSH_VAPID_KEY=

# ── Verified Visit System (VVS) ────────────────────────────────────────
# HMAC key for QR payload signatures + AES-256-GCM sealing of credential
# ciphertexts (re-download support). 32+ random chars in production —
# rotating it invalidates issued QR forms (they can be re-downloaded).
# Example: openssl rand -hex 32
VVS_SIGNING_SECRET=
