# Medbriq — environment configuration template
# Copy to .env and adjust. NEVER commit the real .env file.
#
# Two modes:
#   DEVELOPMENT  → leave FIREBASE_SERVICE_ACCOUNT empty. Uses Prisma + SQLite.
#   PRODUCTION   → set FIREBASE_SERVICE_ACCOUNT (+ the production block at the
#                  bottom). The app switches to Firestore automatically.
#
# Validate any environment with:  bun run check:prod

# ── Database (development only) ──────────────────────────────────────────
# Local SQLite. Production IGNORES this for data storage and uses Firestore.
# It must still be a syntactically valid file: URL because `prisma generate`
# runs during the build.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Node environment: development | test | production
# Vercel sets this for you — do not override it there.
NODE_ENV=development

# Public base URL of the web app (absolute links, future email links).
# Must be https:// in production.
APP_BASE_URL=http://localhost:3000

# ── Production data store (Firebase Firestore) ──────────────────────────
# Compact one-line JSON of a Firebase service-account key:
#   FIREBASE_SERVICE_ACCOUNT="$(jq -c . service-account.json)"
# When set (and valid JSON) the app uses the FirestoreStore (firebase-admin,
# server-side only) instead of the local Prisma/SQLite store. Leave unset for
# local development. NEVER commit the real value, and NEVER paste it in chat —
# store it directly in Vercel / GitHub secrets.
FIREBASE_SERVICE_ACCOUNT=

# Firestore database id. The Firebase admin SDK names the default database
# "(default)" — with the parentheses. Leaving this unset also falls back to
# "(default)".
FIREBASE_DATABASE_ID=(default)

# ── Optional: in-region booking database (hybrid mode) ──────────────────
# When BOTH this and FIREBASE_SERVICE_ACCOUNT are set, the app runs the
# HybridStore: the public directory stays on Firestore while regulated
# booking data (appointments, visit history, fees, notifications, audit logs)
# lives in the database this URL points at. This is the recommended posture
# for Bangladesh data-residency before commercial launch — the booking data
# never leaves the region.
# Leave EMPTY to keep everything in Firestore (simpler, owner-approved).
BOOKING_DATABASE_URL=

# ── Demo mode ───────────────────────────────────────────────────────────
# "true" renders demo labels / sample content. MUST be false or unset in
# production — src/lib/prod-config.ts fails the preflight otherwise.
NEXT_PUBLIC_DEMO_MODE=false

# ── Phone OTP authentication (login + password reset) ──────────────────
# "console" (default) is DEV MODE: the OTP is logged server-side and returned
# in the API response (clearly labeled) so the flow is testable without a paid
# provider. Production REFUSES phone OTP while this is set (echoed codes would
# allow account takeover). With no real provider, phone login is simply
# unavailable in production — email + password and Google still work.
#
# REAL SMS — pick ONE:
#   Bangladesh-local (usually cheapest for BD numbers):
#     SMS_PROVIDER=sslwireless
#     SSLWIRELESS_API_TOKEN=...     (smsplus.sslwireless.com)
#     SSLWIRELESS_SID=...           (sender ID)
#     SMS_SENDER_ID=...             (approved mask)
#   International:
#     SMS_PROVIDER=twilio
#     TWILIO_ACCOUNT_SID=...
#     TWILIO_AUTH_TOKEN=...
#     SMS_SENDER_ID=+15551234567    (Twilio number, or approved alphanumeric)
SMS_PROVIDER=console
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=

# ── Google Sign-In (Google Identity Services) ──────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console (Credentials page) of the
# medifindbd Firebase project. Required for BOTH the browser GIS button and
# server-side ID-token audience verification. Leave empty to disable Google
# sign-in (the UI shows an honest "not configured" state).
GOOGLE_CLIENT_ID=

# ── Firebase web (client) config — push notifications + Google sign-in ──
# Same values as the firebaseConfig object of the Firebase web app
# (Firebase console → Project settings → Your apps → SDK setup).
# Public by design; set on Vercel for production builds. The Firestore rules
# deny all client access, so exposing these is safe.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Web Push certificate key pair (Firebase console → Cloud
# Messaging → Web Push certificates). Improves token reliability.
NEXT_PUBLIC_FIREBASE_PUSH_VAPID_KEY=

# ── Verified Visit System (VVS) ────────────────────────────────────────
# HMAC key for QR payload signatures + AES-256-GCM sealing of credential
# ciphertexts (re-download support). MUST be 32+ random chars in production —
# the preflight rejects anything shorter. Rotating it invalidates issued QR
# forms (they can be re-downloaded).
#   openssl rand -hex 32
VVS_SIGNING_SECRET=
