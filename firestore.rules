rules_version = '2';

// Find Medi Doctor — Firestore security rules (PRODUCTION LOCK-DOWN)
//
// ALL application data access goes through the Next.js API routes using
// the firebase-admin SDK, which authenticates with the
// FIREBASE_SERVICE_ACCOUNT service account and BYPASSES these rules by
// design. No browser ever talks to Firestore directly.
//
// Therefore the correct production posture is: deny everything to
// client SDKs. Even if someone grabs the (public) Firebase web config,
// these rules make reads AND writes impossible from any browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Deny all client-side access. Server-side admin SDK traffic is
      // unaffected (it does not evaluate rules).
      allow read, write: if false;
    }
  }
}
