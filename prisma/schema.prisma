// Medbriq — Global Doctor Discovery & Healthcare Platform
// Prisma schema (SQLite for local/free-first MVP; designed to be portable to PostgreSQL)
//
// Conventions:
// - SQLite does not support native enums in Prisma; status/role fields are strings
//   validated at the application layer (see src/lib/constants.ts).
// - All timestamps are stored in UTC. Bangladesh (initial market) is UTC+6 with no DST.
// - Financial amounts use Float for MVP; production PostgreSQL migration should
//   switch to Decimal (documented in docs/database.md).
// - The @@unique([doctorId, slotStart]) on Appointment is the database-level
//   double-booking guard. Booking code must rely on it, not on frontend checks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String // "" sentinel for OAuth/phone-only accounts (no password set yet)
  name          String
  phone         String?
  // Patient-first onboarding profile fields (master prompt §3.1):
  // every account starts as a user/patient; doctors & hospitals apply later
  // from the dashboard. DOB is an ISO "YYYY-MM-DD" string for store parity.
  dateOfBirth     String?
  presentAddress  String?
  permanentAddress String?
  // Auth provider that created (or most recently linked to) this account:
  // credentials | google | phone. Credential logins remain possible while a
  // password hash exists; see docs/security.md.
  provider      String   @default("credentials")
  phoneVerified Boolean  @default(false)
  avatarUrl     String?
  role          String   @default("PATIENT") // PATIENT | DOCTOR | HOSPITAL | ADMIN (see constants.ts)
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctorProfile DoctorProfile?
  hospitalProfile Hospital?
  sessions      Session[]
  appointments  Appointment[]  @relation("PatientAppointments")
  reviews       Review[]
  auditLogs     AuditLog[]
  notifications Notification[]
  familyMembers FamilyMember[]
  supportTickets SupportTicket[]
}

// Family member profiles a patient can book on behalf of (master prompt §3.36).
model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String // SELF | SPOUSE | CHILD | PARENT | SIBLING | OTHER
  age       Int?
  gender    String? // MALE | FEMALE | OTHER
  phone     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Phone-OTP verification codes (login + password reset). Codes are stored as
// sha256("phone:purpose:code") so a DB leak does not reveal usable codes.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String // normalized BD number, e.g. +8801712345678
  codeHash  String
  purpose   String   @default("LOGIN") // LOGIN | RESET
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

// In-app notifications (Phase 9 core slice). Titles/bodies never contain
// medical information (no patient notes) — only names, dates and reference
// codes, per the master spec's notification privacy rule.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // see NOTIFICATION_TYPES in src/lib/constants.ts
  title     String
  body      String
  meta      String? // JSON string, e.g. {"appointmentId":"…","referenceCode":"MB-…"}
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Specialty {
  id      String             @id @default(cuid())
  name    String             @unique
  nameBn  String?
  slug    String             @unique
  icon    String? // lucide icon name
  doctors DoctorSpecialty[]

  @@index([slug])
}

model Hospital {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  city                String
  address             String?
  phone               String?
  about               String?
  // Facility category: HOSPITAL | CLINIC | DIAGNOSTIC (public directory filter).
  type                String          @default("HOSPITAL")
  // ── Hospital dashboard (master prompt §6) ──
  // A HOSPITAL-role user account linked to this hospital profile.
  userId              String?         @unique
  user                User?           @relation(fields: [userId], references: [id])
  verificationStatus  String          @default("PENDING") // PENDING | UNDER_REVIEW | VERIFIED | REJECTED
  verificationNote    String?
  verifiedAt          DateTime?
  logoUrl             String?
  website             String?
  branches            HospitalBranch[]
  departments         HospitalDepartment[]
  doctors             DoctorProfile[]

  @@index([city])
  @@index([verificationStatus])
}

// Hospital branch (multi-branch support, master prompt §6).
model HospitalBranch {
  id        String   @id @default(cuid())
  hospitalId String
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  phone     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([hospitalId])
}

// Hospital department / specialty unit.
model HospitalDepartment {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  about      String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model DoctorProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String    @unique
  bio                String?
  experienceYears    Int       @default(0)
  consultationFee    Float
  followUpFee        Float     @default(0)
  videoConsultFee    Float?
  regNumber          String? // e.g. BMDC registration number (Bangladesh)
  verificationStatus String    @default("PENDING") // PENDING | UNDER_REVIEW | VERIFIED | REJECTED | MORE_INFO
  verificationNote   String?
  verifiedAt         DateTime?
  city               String
  country            String    @default("Bangladesh")
  chamberAddress     String?
  languages          String? // comma-separated codes: "bn,en"
  supportsVideo      Boolean   @default(false)
  requiresApproval   Boolean   @default(true) // true => booking needs doctor approval; false => instant booking
  photoUrl           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  hospitalId        String?
  hospital          Hospital?         @relation(fields: [hospitalId], references: [id])
  specialties       DoctorSpecialty[]
  availabilityRules AvailabilityRule[]
  chambers          Chamber[]
  appointments      Appointment[]
  reviews           Review[]
  feeSettings       DoctorFeeSettings?
  feeHistory        DoctorFeeHistory[]
  patientVisits     DoctorPatientVisit[]

  @@index([city])
  @@index([verificationStatus])
}

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@index([specialtyId])
}

// Doctor chamber / practice location. A doctor may practice at multiple
// chambers; schedules can be chamber-specific (AvailabilityRule.chamberId)
// or apply to all chambers when null (master prompt §3.17, §5).
model Chamber {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  area      String?
  phone     String?
  mapUrl    String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  rules        AvailabilityRule[]
  appointments Appointment[]

  @@index([doctorId])
}

// Weekly recurring availability. Times are minutes-from-midnight in the clinic's
// local timezone (Asia/Dhaka, UTC+6). dayOfWeek: 0 = Sunday ... 6 = Saturday.
// chamberId: null → the rule applies at every chamber; otherwise it is
// specific to one chamber.
model AvailabilityRule {
  id          String        @id @default(cuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  isActive    Boolean       @default(true)
  chamberId   String?
  chamber     Chamber?      @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([doctorId, dayOfWeek, startMinute])
  @@index([doctorId])
}

model Appointment {
  id            String        @id @default(cuid())
  referenceCode String        @unique // e.g. MB-7K2P9Q — guest lookup reference
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  // Chamber where the consultation takes place (null → doctor's default).
  chamberId     String?
  chamber       Chamber?      @relation(fields: [chamberId], references: [id])
  patientId     String? // set when booked by a logged-in user
  patient       User?         @relation("PatientAppointments", fields: [patientId], references: [id])
  patientName   String
  patientPhone  String
  patientAge    Int?
  patientGender String? // MALE | FEMALE | OTHER
  notes         String? // patient's note for the doctor
  slotStart     DateTime // UTC
  slotEnd       DateTime // UTC
  type          String        @default("IN_PERSON") // IN_PERSON | VIDEO
  status        String        @default("PENDING_APPROVAL") // PENDING_APPROVAL | CONFIRMED | REJECTED | CANCELLED_BY_PATIENT | CANCELLED_BY_DOCTOR | COMPLETED | NO_SHOW | EXPIRED
  bookingMode   String // INSTANT | APPROVAL
  fee           Float
  currency      String        @default("BDT")
  doctorNote    String? // rejection / cancellation reason
  // ── Separated status machine (docs/ARCHITECTURE_CORRECTIONS.md #12) ──
  // Booking status (`status` above), payment status, consultation status and
  // refund status evolve independently — see docs/FEE_SYSTEM.md §Status model.
  paymentStatus      String   @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | PAID | REFUNDED
  consultationStatus String   @default("NOT_STARTED") // NOT_STARTED | COMPLETED | NOT_HELD
  refundStatus       String   @default("NONE") // NONE | REQUESTED | PROCESSED
  // ── Pricing snapshot (docs/FEE_SYSTEM.md) ──
  // Frozen at confirmation: later fee-setting changes never mutate these.
  patientType        String? // NEW | RETURNING | FOLLOW_UP
  feeSettingsVersion Int? // DoctorFeeSettings.version at pricing time
  pricingBasis       String? // JSON snapshot of the classification basis
  pricedAt           DateTime? // when the server computed the price
  // ── Idempotency (docs/ARCHITECTURE_CORRECTIONS.md #10) ──
  idempotencyKey     String? @unique // replay-safe duplicate-submit guard
  // Private consultation note the doctor may attach when completing an
  // appointment (Phase 5 slice). Visible to the patient on their history.
  consultationNote String?
  payments         Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // DATABASE-LEVEL DOUBLE-BOOKING GUARD:
  // one doctor can hold at most one appointment per exact slot start.
  @@unique([doctorId, slotStart])
  @@index([patientId])
  @@index([doctorId, status])
  @@index([slotStart])
}

// ────────────────────────────────────────────────────────────────────────
// Doctor-wise New & Returning Patient Fee System (docs/FEE_SYSTEM.md)
// ────────────────────────────────────────────────────────────────────────

/**
 * Per-doctor fee configuration. `version` increments on every change so a
 * confirmed appointment's snapshot (feeSettingsVersion) always points at an
 * immutable DoctorFeeHistory row.
 */
model DoctorFeeSettings {
  id                      String        @id @default(cuid())
  doctorId                String        @unique
  doctor                  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  newPatientFee           Int           @default(1000) // BDT
  returningPatientFee     Int           @default(600) // BDT
  returningValidityValue  Int           @default(6)
  returningValidityUnit   String        @default("MONTHS") // DAYS | MONTHS
  followUpEnabled         Boolean       @default(false)
  followUpFee             Int           @default(0) // BDT
  followUpValidityValue   Int           @default(15)
  followUpValidityUnit    String        @default("DAYS")
  version                 Int           @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([doctorId])
}

/**
 * Immutable audit trail of every fee configuration. One row per version;
 * version N mirrors DoctorFeeSettings exactly as published. Written in the
 * same transaction that updates DoctorFeeSettings.
 */
model DoctorFeeHistory {
  id                      String        @id @default(cuid())
  doctorId                String
  doctor                  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  version                 Int
  newPatientFee           Int
  returningPatientFee     Int
  returningValidityValue  Int
  returningValidityUnit   String
  followUpEnabled         Boolean
  followUpFee             Int
  followUpValidityValue   Int
  followUpValidityUnit    String
  changeReason            String?
  changedBy               String? // acting user id
  createdAt               DateTime      @default(now())

  @@index([doctorId, version])
}

/**
 * doctor_patient_history — materialized visit history per (doctor, patient).
 * Written transactionally when an appointment is marked COMPLETED. Only
 * qualifying visits (completed consultation + settled payment, see
 * docs/FEE_SYSTEM.md §Eligibility) establish or renew returning-patient
 * eligibility. `patientPhone` is stored normalized so guest bookings (no
 * account) still attach to the patient's history.
 */
model DoctorPatientVisit {
  id                        String        @id @default(cuid())
  doctorId                  String
  doctor                    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId             String        @unique
  patientId                 String? // User.id when the booking was authenticated
  patientPhone              String // normalized BD number
  slotStart                 DateTime // scheduled visit time (UTC)
  completedAt               DateTime // when the consultation was completed
  qualifying                Boolean       @default(true)
  paymentStatusAtCompletion String        @default("NOT_REQUIRED")
  recordedAt                DateTime      @default(now())

  @@index([doctorId, patientId, qualifying])
  @@index([doctorId, patientPhone, qualifying])
}

model Review {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   User          @relation(fields: [patientId], references: [id])
  rating    Int // 1..5
  comment   String?
  createdAt DateTime      @default(now())

  @@unique([doctorId, patientId])
  @@index([doctorId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // e.g. DOCTOR_VERIFIED, APPOINTMENT_CONFIRMED
  entity    String // e.g. DoctorProfile, Appointment
  entityId  String?
  meta      String? // JSON string with action details
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Country {
  id        String  @id @default(cuid())
  code      String  @unique // ISO 3166-1 alpha-2, e.g. BD
  name      String
  currency  String // e.g. BDT
  phoneCode String // e.g. +880
  isActive  Boolean @default(true)
}

// ────────────────────────────────────────────────────────────────────────
// Payments (sandbox simulation), support, platform configuration
// ────────────────────────────────────────────────────────────────────────

/**
 * Payment transaction record for an appointment. SANDBOX ONLY in this demo —
 * no real money moves; the UI labels this clearly. Payment status here is
 * the transaction ledger; Appointment.paymentStatus stays the booking-level
 * summary axis (docs/ARCHITECTURE_CORRECTIONS.md #12).
 */
model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  method        String // BKASH | NAGAD | CARD | CASH
  amount        Float
  currency      String      @default("BDT")
  status        String      @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  txnRef        String? // sandbox transaction reference
  failureReason String?
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  refundedAt    DateTime?
}

/** Patient/doctor support tickets (master prompt §3.38, §7). */
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String?
  subject   String
  message   String
  category  String   @default("GENERAL") // GENERAL | BOOKING | PAYMENT | ACCOUNT | REPORT
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority  String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/** Runtime feature flags (admin-controlled, master prompt §7). */
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. telehealth, onlinePayments
  enabled     Boolean  @default(false)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/** Key/value platform configuration (commission %, currency, i18n, etc.). */
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────
// Verified Visit System (VVS) — two-part printable appointment forms,
// QR-based visit verification and immutable digital visit records.
//
// Design notes (docs/VVS.md):
// - VVS tables are intentionally NOT foreign-keyed to Appointment: the
//   booking engine may run on the Firestore store (see src/lib/data), so
//   VVS rows reference appointments by their stable logical id + a denormalized
//   snapshot of the fields the printed form and receipts must preserve
//   (fee, patient type, chamber, slot). Snapshots are frozen at issuance —
//   later appointment edits never rewrite an issued document.
// - Tokens and confirmation codes are stored hashed (sha256); a database
//   leak does not yield usable QR or confirmation credentials.
// - completed_visits are immutable: corrections append a new audited event
//   (correctionStatus) instead of overwriting the original record.
// ────────────────────────────────────────────────────────────────────────

/** One verifiable appointment credential per appointment (QR + manual code). */
model AppointmentVerification {
  id             String    @id @default(cuid())
  appointmentId  String    @unique
  referenceCode  String    // appointment MB-XXXXXX reference (lookup aid)
  doctorId       String
  chamberId      String?
  patientId      String? // User.id when booked by a logged-in patient
  patientName    String
  patientPhone   String
  slotStart      DateTime // UTC
  serialNumber   Int // per (doctor, chamber, Dhaka calendar day) rank by slotStart
  qrTokenHash    String    @unique // sha256(qrToken) — fast constant-time lookup
  qrTokenEnc     String? // AES-256-GCM ciphertext — re-download returns the SAME credential
  manualCodeHash String // sha256(manualCode) — printed fallback when the QR is damaged
  manualCodeEnc  String? // AES-256-GCM ciphertext
  status         String    @default("ACTIVE") // ACTIVE | USED | REVOKED
  policy         String    @default("B") // A | B | C (verification policy at issuance)
  documentVersion Int      @default(1)
  issueCount     Int       @default(0) // re-downloads/prints (audit-relevant)
  lastIssuedAt   DateTime?
  checkInAt      DateTime?
  checkInById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documents      AppointmentDocument[]

  @@index([doctorId, slotStart])
  @@index([referenceCode])
}

/** Append-only issuance log for the two-part A4 form (print + PDF download). */
model AppointmentDocument {
  id             String   @id @default(cuid())
  verificationId String
  verification   AppointmentVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  appointmentId  String
  format         String // PRINT | PDF
  lang           String // en | bn
  issuedById     String? // actor (patient owner / doctor / staff)
  issuedAt       DateTime @default(now())

  @@index([appointmentId])
}

/**
 * The permanent digital visit record — created exactly once per appointment
 * by an authorized doctor (or, under policy C, chamber staff). Immutable:
 * disputes and corrections append fields / new audit events, never overwrite
 * the completion facts. The digital record is the source of truth; the paper
 * form is a convenience for the chamber.
 */
model CompletedVisit {
  id                   String   @id @default(cuid())
  appointmentId        String   @unique
  referenceCode        String
  doctorId             String
  doctorName           String // display name at completion (receipt snapshot)
  chamberId            String?
  chamberName          String? // chamber display name at completion
  patientId            String?
  patientName          String
  patientPhone         String
  slotStart            DateTime // scheduled slot (UTC)
  // ── fee snapshot (docs/FEE_SYSTEM.md §3) — frozen at completion so the
  //    receipt preserves the exact price the patient was charged ──
  fee                  Float
  currency             String    @default("BDT")
  patientType          String? // NEW | RETURNING | FOLLOW_UP
  completedById        String // performing doctor/staff user id
  completedByName      String // display name at completion time
  completedAt          DateTime @default(now()) // server-generated
  verificationMethod   String // QR | MANUAL_CODE | REFERENCE
  policy               String // A | B | C applied at completion
  patientConfirmationStatus String @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | CONFIRMED | EXPIRED
  patientConfirmedAt   DateTime?
  patientConfirmedVia  String? // APP | CODE
  receiptNumber        String   @unique // e.g. VR-XXXXXXXX
  // ── correction workflow (never silent overwrites) ──
  correctionStatus     String? // null | DISPUTED | CORRECTED
  correctedById        String?
  correctedAt          DateTime?
  correctionReason     String?
  consultationNote     String?
  createdAt            DateTime @default(now())

  confirmation         PatientVisitConfirmation?
  disputes             VisitDispute[]

  @@index([doctorId, completedAt])
  @@index([patientId])
  @@index([patientPhone])
}

/**
 * Mode B one-time patient confirmation code. Single-use, expiring,
 * attempt-limited; the raw code is only shown inside the patient's own
 * authenticated session (never in URLs or QR payloads).
 */
model PatientVisitConfirmation {
  id            String   @id @default(cuid())
  visitId       String   @unique
  visit         CompletedVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  appointmentId String   @unique
  codeHash      String // sha256(appointmentId:code)
  attempts      Int      @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([appointmentId])
}

/** Patient-reported dispute over a completed visit (append-only workflow). */
model VisitDispute {
  id            String    @id @default(cuid())
  visitId       String
  visit         CompletedVisit @relation(fields: [visitId], references: [id])
  appointmentId String
  reportedById  String?
  reporterName  String
  reporterPhone String?
  reason        String
  status        String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([appointmentId])
}

/**
 * Web-push (FCM) registration tokens per user. A user may have several
 * (multiple browsers/devices); tokens are pruned automatically when FCM
 * reports them invalid.
 */
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("web") // web | android | ios
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
}
